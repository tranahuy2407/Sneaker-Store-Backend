# Database
DB_NAME=sneaker_store
DB_USER=postgres
DB_PASSWORD=your_password
DB_HOST=localhost
DB_PORT=5432
DB_DIALECT=postgres
DATABASE_URL=postgres://user:password@host:port/dbname

# Redis (Local)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Redis (Production - Redis Cloud, Upstash, Railway, AWS ElastiCache)
# REDIS_HOST=redis-12345.c123.us-east-1-4.ec2.cloud.redislabs.com
# REDIS_PORT=6379
# REDIS_PASSWORD=your_redis_password
# REDIS_DB=0

# JWT
JWT_ACCESS_SECRET=your_access_secret_key
JWT_REFRESH_SECRET=your_refresh_secret_key
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id

# Email
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Frontend
FRONTEND_URL=http://localhost:5173

# Server
PORT=8080
NODE_ENV=development

# Seed Secret (dùng để bảo vệ API seed trên production)
SEED_SECRET=sneaker_seed_2025


AUTO_RUN_SEED=false

# Để tự động chạy seed ở môi trường production (NODE_ENV=production), 
# hãy thêm biến: AUTO_RUN_SEED_SECRET=<giá trị của SEED_SECRET>

# RabbitMQ
RABBITMQ_URL=amqp://localhost
